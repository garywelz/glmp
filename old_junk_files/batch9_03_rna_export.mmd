    style S fill:#45b7d1
    style T fill:#f4a261
    style U fill:#f4a261
    style V fill:#feca57
    style W fill:#feca57
    style X fill:#feca57
    style Y fill:#feca57
    style Z fill:#feca57
    style AA fill:#feca57
