    style L fill:#96ceb4
    style M fill:#4ecdc4
    style N fill:#4ecdc4
    style O fill:#96ceb4
    style P fill:#feca57
    style Q fill:#4ecdc4
    style R fill:#96ceb4
    style S fill:#45b7d1
    style T fill:#45b7d1
    style U fill:#4ecdc4
    style V fill:#4ecdc4
    style W fill:#feca57
    style X fill:#feca57
    style Y fill:#feca57
    style Z fill:#feca57
    style AA fill:#feca57
    style BB fill:#feca57
