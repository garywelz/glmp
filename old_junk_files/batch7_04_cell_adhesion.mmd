graph TD
    A[Cell-Cell Contact] --> B{Adhesion Type?}
    B -->|Cadherin| C[Cadherin Binding]
    B -->|Integrin| D[Integrin Binding]
    B -->|Selectin| E[Selectin Binding]
    B -->|Immunoglobulin| F[IgCAM Binding]
    
    C --> G[Cadherin Complex]
    G --> H[Adherens Junction]
    H --> I[Cell Adhesion]
    
    D --> J[Integrin Complex]
    J --> K[Focal Adhesion]
    K --> I
    
    E --> L[Selectin Complex]
    L --> M[Cell Rolling]
    M --> I
    
    F --> N[IgCAM Complex]
    N --> O[Cell Adhesion]
    O --> I
    
    I --> P[Cell Adhesion Complete]
    
    %% Regulation
    P --> Q[Adhesion Status]
    Q --> R{Adhesion Required?}
    R -->|Yes| S[Adhesion Maintenance]
    R -->|No| T[Adhesion Dissolution]
    
    %% Key proteins
    U[Cadherins] --> C
    V[Integrins] --> D
    W[Selectins] --> E
    X[IgCAMs] --> F
    Y[Adhesion Proteins] --> I
    Z[Adhesion Regulators] --> P
    
    %% Styling
    style A fill:#ff6b6b
    style B fill:#45b7d1
    style C fill:#feca57
    style D fill:#feca57
    style E fill:#feca57
    style F fill:#feca57
    style G fill:#45b7d1
    style H fill:#f4a261
    style I fill:#96ceb4
    style J fill:#45b7d1
    style K fill:#f4a261
    style L fill:#45b7d1
    style M fill:#f4a261
    style N fill:#45b7d1
    style O fill:#f4a261
    style P fill:#96ceb4
    style Q fill:#45b7d1
    style R fill:#45b7d1
    style S fill:#f4a261
    style T fill:#f4a261
    style U fill:#feca57
    style V fill:#feca57
    style W fill:#feca57
    style X fill:#feca57
    style Y fill:#feca57
    style Z fill:#feca57
