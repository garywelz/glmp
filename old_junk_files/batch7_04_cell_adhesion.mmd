graph TD
    A[Cell-Cell Contact] --> B{Adhesion Type?}
    B -->|Cadherin| C[Cadherin Binding]
    B -->|Integrin| D[Integrin Binding]
    B -->|Selectin| E[Selectin Binding]
    B -->|Immunoglobulin| F[IgCAM Binding]
    
    C --> G[Cadherin Complex]
    G --> H[Adherens Junction]
    H --> I[Cell Adhesion]
    
    D --> J[Integrin Complex]
    J --> K[Focal Adhesion]
    K --> I
    
    E --> L[Selectin Complex]
    L --> M[Cell Rolling]
    M --> I
    
    F --> N[IgCAM Complex]
    N --> O[Cell Adhesion]
    O --> I
    
    I --> P[Cell Adhesion Complete]
    
    %% Regulation
    P --> Q[Adhesion Status]
    Q --> R{Adhesion Required?}
    R -->|Yes| S[Adhesion Maintenance]
    R -->|No| T[Adhesion Dissolution]
    
    %% Key proteins
    U[Cadherins] --> C
    V[Integrins] --> D
    W[Selectins] --> E
    X[IgCAMs] --> F
    Y[Adhesion Proteins] --> I
    Z[Adhesion Regulators] --> P
    
    %% Styling
    style A fill:#ffd1d1
    style B fill:#bbdefb
    style C fill:#b59d00
    style D fill:#b59d00
    style E fill:#b59d00
    style F fill:#b59d00
    style G fill:#bbdefb
    style H fill:#f4a261
    style I fill:#c8e6c9
    style J fill:#bbdefb
    style K fill:#f4a261
    style L fill:#bbdefb
    style M fill:#f4a261
    style N fill:#bbdefb
    style O fill:#f4a261
    style P fill:#c8e6c9
    style Q fill:#bbdefb
    style R fill:#bbdefb
    style S fill:#f4a261
    style T fill:#f4a261
    style U fill:#b59d00
    style V fill:#b59d00
    style W fill:#b59d00
    style X fill:#b59d00
    style Y fill:#b59d00
    style Z fill:#b59d00
