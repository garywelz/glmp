graph TD
    %% Environmental Stress Signals
    A[Nutrient Depletion] --> B[Glucose Starvation]
    C[Amino Acid Limitation] --> D[Nitrogen Stress]
    E[Phosphate Limitation] --> F[Phosphate Stress]
    G[Cell Density Signal] --> H[Quorum Sensing]
    I[DNA Damage] --> J[SOS Response]
    
    %% Kinase Activation Pathways
    B --> K{KinA Sensor?}
    D --> L{KinB Sensor?}
    F --> M{KinC Sensor?}
    H --> N{KinD Sensor?}
    J --> O{KinE Sensor?}
    
    %% All kinases activate
    K -->|Yes| P[KinA Autophosphorylation]
    L -->|Yes| Q[KinB Autophosphorylation]
    M -->|Yes| R[KinC Autophosphorylation]
    N -->|Yes| S[KinD Autophosphorylation]
    O -->|Yes| T[KinE Autophosphorylation]
    
    %% Phosphorylation of Spo0F
    P --> U[KinA-P Formation]
    Q --> V[KinB-P Formation]
    R --> W[KinC-P Formation]
    S --> X[KinD-P Formation]
    T --> Y[KinE-P Formation]
    
    U --> Z[Phosphotransfer to Spo0F]
    V --> Z
    W --> Z
    X --> Z
    Y --> Z
    
    %% First Phosphorelay Step
    Z --> AA[Spo0F~P Formation]
    AA --> AB[Spo0F~P Accumulation]
    
    %% Negative Regulation by Phosphatases
    AC[Spo0E Phosphatase] --> AD[Dephosphorylates Spo0F~P]
    AE[RapA Phosphatase] --> AF[Dephosphorylates Spo0F~P]
    AB --> AD
    AB --> AF
    AD --> AG[Reduced Spo0F~P]
    AF --> AG
    
    %% AND Gate: High Spo0F~P AND Low Phosphatase
    AB --> ANDGATE1{High Spo0F~P AND<br/>Low Phosphatase?}
    AG --> ANDGATE1
    ANDGATE1 -->|Yes| AH[Net Spo0F~P Increase]
    ANDGATE1 -->|No| AI[Spo0F~P Insufficient]
    
    %% Second Phosphorelay Step
    AH --> AJ[Spo0B Phosphotransferase]
    AJ --> AK[Phosphotransfer to Spo0A]
    AK --> AL[Spo0A~P Formation]
    
    %% Spo0A~P Threshold
    AL --> AM{Spo0A~P<br/>Threshold?}
    AM -->|Low| AN[Spo0A~P Low State]
    AM -->|Medium| AO[Spo0A~P Medium State]
    AM -->|High| AP[Spo0A~P High State]
    
    %% Low Spo0A~P - Vegetative Growth
    AN --> AQ[Vegetative Gene Expression]
    AQ --> AR[Cell Division Continues]
    AR --> AS[No Sporulation]
    
    %% Medium Spo0A~P - Transition
    AO --> AT[Early Sporulation Genes]
    AT --> AU[spoIIA Activation]
    AU --> AV[spoIIE Activation]
    AV --> AW[spoIIG Activation]
    AW --> AX[Commitment Point]
    
    %% High Spo0A~P - Full Sporulation
    AP --> AY[Late Sporulation Genes]
    AY --> AZ[/Vegetative Gene Repression/]
    AZ --> BA[/abrB Repression/]
    BA --> BB[Cell Asymmetry]
    
    %% Sporulation Stages
    AX --> BC[Sporulation Stage 0]
    BB --> BC
    BC --> BD[Asymmetric Septation]
    BD --> BE[Forespore Formation]
    BE --> BF[Mother Cell Differentiation]
    BF --> BG[Spore Coat Assembly]
    BG --> BH[Spore Maturation]
    BH --> BI[Dormant Spore]
    
    %% System Outputs
    AS --> BJ[Continued Growth]
    BI --> BK[Stress Resistance]
    BK --> BL[Long-term Survival]
    AI --> BM[Signal Insufficient]
    BM --> AS
    
