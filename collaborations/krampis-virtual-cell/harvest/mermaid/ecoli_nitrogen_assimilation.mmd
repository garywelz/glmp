graph TD
    %% Nitrogen Status Input
    A[Ammonia Limitation] --> B[Low Nitrogen Signal]
    C[Glutamine Depletion] --> D[Nitrogen Starvation]
    B --> E[Reduced NH4+ Availability]
    D --> E
    
    %% PII Protein Modification
    E --> F[PII Protein GlnB]
    F --> G[Low Glutamine]
    G --> H[2-Ketoglutarate Accumulation]
    H --> I[2-KG Binds PII]
    I --> J[PII Conformational Change]
    J --> K[PII-T Active Form]
    
    %% Decision: Nitrogen Status
    K --> L{Nitrogen<br/>Limitation?}
    
    %% NtrB Kinase Activation
    L -->|Yes| M[PII-T Releases NtrB]
    M --> N[NtrB Kinase Activity]
    N --> O[ATP Binding]
    O --> P[NtrB Autophosphorylation]
    P --> Q[NtrB-P Formation]
    
    %% Phosphotransfer to NtrC
    Q --> R[Phosphotransfer to NtrC]
    R --> S[NtrC-P Active Form]
    S --> T[NtrC-P Oligomerization]
    T --> U[NtrC-P Enhancer Binding]
    
    %% σ54 Recruitment
    V[σ54 RpoN] --> W[σ54 Binds glnA Promoter]
    W --> X[RNAP-σ54 Complex]
    X --> Y[Closed Complex]
    
    %% AND Gate 1: σ54 Activation
    U --> ANDGATE1{NtrC-P Enhancer AND<br/>RNAP-σ54 Complex?}
    Y --> ANDGATE1
    
    %% ATP-Dependent Activation
    ANDGATE1 -->|Yes| Z[NtrC-P Contacts σ54]
    Z --> AA[ATP Hydrolysis]
    AA --> AB[DNA Melting]
    AB --> AC[Open Complex Formation]
    AC --> AD[Transcription Initiation]
    
    %% glnA Expression
    AD --> AE[glnA mRNA Synthesis]
    AE --> AF[glnA Translation]
    AF --> AG[Glutamine Synthetase GS]
    
    %% Glutamine Synthesis
    AH(\1) --> AI[GS Substrate Binding]
    AJ(\1) --> AI
    AG --> AK[GS Catalysis]
    AI --> AK
    AK --> AL[ATP-Dependent Ligation]
    AL --> AM[Glutamine Production]
    
    %% AND Gate 2: Other Ntr Genes
    U --> ANDGATE2{NtrC-P AND<br/>Other Ntr Promoters?}
    V --> AN[σ54 at Multiple Promoters]
    AN --> ANDGATE2
    
    ANDGATE2 -->|Yes| AO[nac Gene Activation]
    AO --> AP[NAC Transcription Factor]
    AP --> AQ[Nitrogen Assimilation Genes]
    AQ --> AR[Alternative N Source Utilization]
    
    %% High Nitrogen Path
    L -->|No| AS[High Ammonia]
    AS --> AT[Glutamine Synthesis]
    AT --> AU[Glutamine Binds PII]
    AU --> AV[PII-ADP-Glutamine]
    AV --> AW[PII Binds NtrB]
    AW --> AX[NtrB Phosphatase Activity]
    AX --> AY[NtrC-P Dephosphorylation]
    AY --> AZ[NtrC Inactive]
    AZ --> BA[Low glnA Expression]
    BA --> BB[Basal GS Levels]
    
    %% AND Gate 3: Feedback Loop
    AM --> ANDGATE3{Glutamine AND<br/>PII Available?}
    F --> ANDGATE3
    ANDGATE3 -->|Yes| AU
    
    %% System Outputs
    AM --> BC[Nitrogen Assimilation]
    AR --> BD[Alternative N Sources Used]
    BB --> BE[Ammonia-Sufficient Growth]
    BC --> BF[Nitrogen Homeostasis]
    
