graph TD
    %% Chromatin Locations
    A[Genomic DNA] --> B{OR: Which<br/>Locus?}
    B -->|Telomeres| C[Telomeric Regions]
    B -->|HMR/HML| D[Hidden Mating Type]
    B -->|rDNA| E[Ribosomal DNA Array]
    B -->|Active Genes| F(\1)
    
    %% Euchromatin Pathway
    F --> G[Histone Acetylation]
    G --> H[Transcription Active]
    H --> I([Gene Expression])
    
    %% Telomeric Silencing
    C --> J[Telomeric Repeats TG1-3]
    J --> K[Rap1 Binding Sites]
    K --> L[Rap1 Protein Recruitment]
    
    L --> M{AND: Rap1<br/>Bound?}
    M -->|No| N[/No Silencing/]
    M -->|Yes| O[Rap1 C-terminal Domain]
    
    O --> P[Sir4 Recruitment]
    O --> Q[Sir3 Recruitment]
    
    %% HM Loci Silencing
    D --> R[/E Silencer Element/]
    R --> S[Multiple Binding Sites]
    S --> T[Rap1 + Abf1 + ORC]
    
    T --> U["/AND: All Silencer<br/>Factors?"]
    U -->|No - Missing Factors| N
    U -->|Yes - Complete| V[/Silencer Complex/]
    
    V --> W[Sir1 Recruited]
    W --> X[Sir2/3/4 Nucleation]
    
    %% Sir Complex Assembly
    P --> Y{AND: Sir2<br/>Present?}
    Q --> Y
    X --> Y
    Y -->|No| N
    Y -->|Yes| Z[Sir2/3/4 Complex Forms]
    
    %% Sir2 NAD+ Requirement
    Z --> AA{AND: NAD+<br/>Available?}
    AA -->|No - NAD+ Depleted| AB[/Sir2 Inactive/]
    AA -->|Yes - NAD+ Present| AC[Sir2 Deacetylase Active]
    
    %% Histone Deacetylation
    AC --> AD[H4-K16 Acetyl Group]
    AD --> AE[Sir2 Catalysis]
    AE --> AF[NAD+ → Nicotinamide + ADP-ribose]
    AF --> AG[H4-K16 Deacetylated]
    
    %% Sir3/4 Binding
    AG --> AH{AND: Sir3<br/>Binding Domain?}
    AH -->|No| AI[No Spreading]
    AH -->|Yes| AJ[Sir3 Binds Deacetylated H4]
    
    AJ --> AK{AND: Sir4<br/>Present?}
    AK -->|No| AI
    AK -->|Yes| AL[Sir3/4 Heterodimer]
    
    AL --> AM[Sir Complex Stabilized]
    AM --> AN[Nucleosome Binding]
    
    %% Spreading Mechanism
    AN --> AO[Adjacent Nucleosome]
    AO --> AP[Sir2 Deacetylates Next H4]
    AP --> AQ[Sir3/4 Binds Next Nucleosome]
    AQ --> AR[Spreading Continues]
    
    AR --> AS{OR: Continue<br/>Spreading?}
    AS -->|Yes - More Nucleosomes| AO
    AS -->|No - Boundary Reached| AT[/Silenced Domain Established/]
    
    %% Boundary Elements
    AT --> AU[tRNA Genes]
    AT --> AV[Insulator Elements]
    AU --> AW[Barrier to Spreading]
    AV --> AW
    AW --> AX[Defined Silent Region]
    
    %% Transcription Repression
    AX --> AY[Nucleosome Compaction]
    AY --> AZ{AND: RNA Pol II<br/>Access?}
    AZ -->|Yes - Can Access| BA[/Weak Silencing/]
    AZ -->|No - Blocked| BB[/Strong Silencing/]
    
    BB --> BC[/Transcription Prevented/]
    BC --> BD[/Gene Silenced/]
    
    %% Sir2 Metabolic Connection
    AC --> BE[Sirtuins Link Metabolism]
    BE --> BF{OR: NAD+/NADH<br/>Ratio?}
    BF -->|High NAD+ - Fed| BG[/Active Silencing/]
    BF -->|Low NAD+ - Starved| BH[/Reduced Silencing/]
    
    BG --> BI[Caloric Restriction Effect]
    BI --> BJ[Enhanced Sir2 Activity]
    BJ --> BK[Lifespan Extension]
    BK --> BL[/Longevity Phenotype/]
    
    %% rDNA Silencing
    E --> BM[rDNA Repeats]
    BM --> BN[Sir2 RENT Complex]
    BN --> BO{AND: Net1<br/>AND Cdc14?}
    BO -->|No| BP[rDNA Instability]
    BO -->|Yes| BQ[/rDNA Silencing/]
    BQ --> BR[/Suppressed Recombination/]
    BR --> BS([Genomic Stability])
    
    %% Loss of Silencing
    AB --> BT[/Sir2 Cannot Function/]
    BT --> BU[Histones Remain Acetylated]
    BU --> BV[/Sir3/4 Cannot Bind/]
    BV --> BW[/Silencing Lost/]
    BW --> BX[Inappropriate Gene Expression]
    BX --> BY([Mating Type Defects])
    
    N --> BZ([No Silent Chromatin])
    
