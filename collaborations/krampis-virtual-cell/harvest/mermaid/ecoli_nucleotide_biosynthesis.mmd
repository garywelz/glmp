graph TD
    %% Entry Point
    A[Ribose-5-Phosphate] --> B["PrsA: R5P + ATP → PRPP"]
    B --> C[PRPP Phosphoribosyl Pyrophosphate]
    
    %% OR Gate 1: Purine vs Pyrimidine
    C --> D{OR: Which<br/>Nucleotide?}
    D -->|Purines| E[Purine Biosynthesis]
    D -->|Pyrimidines| F[Pyrimidine Biosynthesis]
    
    %% Purine Pathway Step-by-Step
    E --> G["PurF: PRPP + Gln → 5-Phosphoribosylamine"]
    G --> H["PurD: + Gly"]
    H --> I[GAR Glycinamide Ribotide]
    I --> J["PurN: + Formyl-THF"]
    J --> K(\1)
    K --> L["PurL: + Gln"]
    L --> M(\1)
    M --> N["PurM: Cyclization"]
    N --> O[AIR 5-Aminoimidazole Ribotide]
    O --> P["PurK: + CO2"]
    P --> Q(\1)
    Q --> R["PurE: + Asp"]
    R --> S(\1)
    S --> T["PurB: Release Fumarate"]
    T --> U(\1)
    U --> V["PurH: + Formyl-THF"]
    V --> W(\1)
    W --> X["PurH: Cyclization"]
    X --> Y[IMP Inosine Monophosphate]
    
    %% IMP Branch Point
    Y --> Z{OR: AMP<br/>or GMP?}
    Z -->|PurA| AA[IMP + Asp + GTP → AMP]
    Z -->|PurB+GuaA| AB[IMP + NAD → GMP]
    
    AA --> AC[AMP Adenosine Monophosphate]
    AB --> AD[GMP Guanosine Monophosphate]
    
    %% Pyrimidine Pathway
    F --> AE["CarAB: Gln + CO2 + ATP → Carbamoyl-P"]
    AE --> AF["PyrB: Carbamoyl-P + Asp"]
    AF --> AG[Carbamoyl Aspartate]
    AG --> AH["PyrC: Cyclization"]
    AH --> AI[Dihydroorotate DHO]
    AI --> AJ["PyrD: DHO + NAD → Orotate"]
    AJ --> AK(\1)
    AK --> AL["PyrE: Orotate + PRPP → Orotidine-5-P"]
    AL --> AM[Orotidine Monophosphate]
    AM --> AN["PyrF: Decarboxylation"]
    AN --> AO[UMP Uridine Monophosphate]
    
    %% UMP to CTP
    AO --> AP["PyrH: UMP + ATP → UDP"]
    AP --> AQ(\1)
    AQ --> AR["Ndk: UDP + ATP → UTP"]
    AR --> AS(\1)
    AS --> AT["PyrG: UTP + Gln + ATP → CTP"]
    AT --> AU[CTP Cytidine Triphosphate]
    
    %% Nucleoside Diphosphate Kinase
    AC --> AV[AMP → ADP → ATP]
    AD --> AW[GMP → GDP → GTP]
    
    AV --> AX{AND: ATP<br/>Levels?}
    AW --> AY{AND: GTP<br/>Levels?}
    AS --> AZ{AND: UTP<br/>Levels?}
    AU --> BA{AND: CTP<br/>Levels?}
    
    %% Ribonucleotide Reductase
    AX -->|Sufficient| BB["RNR: ATP → dATP"]
    AY -->|Sufficient| BC["RNR: GTP → dGTP"]
    AZ -->|Sufficient| BD["RNR: UTP → dUTP"]
    BA -->|Sufficient| BE["RNR: CTP → dCTP"]
    
    BD --> BF["Dut: dUTP → dUMP"]
    BF --> BG["ThyA: dUMP + CH2-THF → dTMP"]
    BG --> BH[dTMP → dTDP → dTTP]
    
    %% DNA/RNA Synthesis
    BB --> BI(\1)
    BC --> BJ(\1)
    BE --> BK(\1)
    BH --> BL(\1)
    
    BI --> BM{OR: DNA<br/>or RNA?}
    BJ --> BM
    BK --> BM
    BL --> BM
    AV --> BM
    AW --> BM
    AS --> BM
    AU --> BM
    
    BM -->|DNA| BN[DNA Polymerase]
    BM -->|RNA| BO[RNA Polymerase]
    
    BN --> BP([DNA Replication])
    BO --> BQ([Transcription])
    
    %% Feedback Regulation
    AC --> BR[/PurR Repressor/]
    BR --> BS[/pur Operon Repression/]
    
    AO --> BT[PyrR Attenuation]
    BT --> BU[pyr Operon Control]
    
    %% Salvage Pathways
    BV(\1) --> BW["Apt: + PRPP → AMP"]
    BW --> AC
    BX(\1) --> BY["Gpt: + PRPP → GMP"]
    BY --> AD
    BZ(\1) --> CA["Upp: + PRPP → UMP"]
    CA --> AO
    
