graph TD
    %% Input Signals
    A[Maltose in Medium] --> B[Maltose Transport]
    C[Maltodextrins in Medium] --> D[Maltodextrin Transport]
    E[Glucose Status] --> F[cAMP Synthesis]
    
    %% Transport
    B --> G[LamB Porin]
    D --> G
    G --> H[Maltose/Maltodextrin Inside]
    H --> I[Maltotriose Formation]
    
    %% Decision: Maltose Present?
    I --> J{Maltose/Maltotriose<br/>Present?}
    
    %% No Maltose - Basal State
    J -->|No| K[MalT Inactive]
    K --> L[Low mal Gene Expression]
    L --> M[Basal Transport Only]
    M --> N[No Maltose Catabolism]
    
    %% Maltose Present - MalT Activation
    J -->|Yes| O[Maltotriose Binds MalT]
    O --> P[MalT Conformational Change]
    P --> Q[MalT Active Form]
    
    %% Decision: Glucose Status
    F --> R{High cAMP?}
    
    %% AND Gate 1: CRP-cAMP Requirement
    Q --> ANDGATE1{MalT Active AND<br/>CRP-cAMP Present?}
    R -->|Yes| S[CRP-cAMP Complex]
    S --> ANDGATE1
    
    %% MalK Regulatory Signal
    T[MalK ATPase] --> U[ATP Binding]
    U --> V[MalK-ATP Complex]
    V --> W[MalK Regulatory State]
    
    %% AND Gate 2: MalK Anti-activation
    ANDGATE1 -->|Yes| ANDGATE2{MalT-CRP Active AND<br/>MalK-ATP Low?}
    W --> X{High MalK-ATP?}
    X -->|No| ANDGATE2
    
    %% Full Activation
    ANDGATE2 -->|Yes| Y[MalT Binds Mal Boxes]
    Y --> Z[Multiple Operon Activation]
    
    %% malEFG Operon
    Z --> AA[malEFG Transcription]
    AA --> AB[MalE Periplasmic Binding Protein]
    AB --> AC[MalF Membrane Protein]
    AC --> AD[MalG Membrane Protein]
    
    %% malK-lamB-malM Operon
    Z --> AE[malK-lamB-malM Transcription]
    AE --> T
    AE --> AF[LamB Maltose Porin]
    AF --> G
    AE --> AG[MalM Maltose Regulation]
    
    %% malPQ Operon
    Z --> AH[malPQ Transcription]
    AH --> AI[MalP Phosphorylase]
    AI --> AJ[MalQ Amylomaltase]
    
    %% Maltose Catabolism
    H --> AK[Maltose Substrate]
    AI --> AL[Maltodextrin to Maltose + Glucose-1-P]
    AK --> AL
    AL --> AM[Maltose Hydrolysis]
    AJ --> AN[Maltose to Glucose]
    AM --> AN
    AN --> AO[Glucose Products]
    AO --> AP[Glycolysis Entry]
    AP --> AQ[Energy Production]
    
    %% AND Gate 3: malT Autoactivation
    Y --> ANDGATE3{MalT Active AND<br/>malT Promoter?}
    Q --> ANDGATE3
    ANDGATE3 -->|Yes| AR[malT Gene Transcription]
    AR --> AS[More MalT Protein]
    AS --> K
    
    %% Catabolite Repression Path
    R -->|No| AT[Low cAMP]
    AT --> AU[CRP Inactive]
    AU --> AV[Weak mal Expression]
    AV --> AW[Glucose Preference]
    
    %% MalK Inhibition Path
    X -->|Yes| AX[/MalK-ATP Inhibits MalT/]
    AX --> AY[Reduced mal Expression]
    AY --> AZ[Feedback Control]
    
    %% System Outputs
    N --> BA[Maltose System Off]
    AQ --> BB[Maltose Utilization]
    AW --> BC[Glucose-Preferential Growth]
    AZ --> BD[Regulated Mal Expression]
    
