graph TD
    %% Entry Points
    A[Glucose-6-Phosphate] --> B{OR: Which<br/>Pathway?}
    B -->|Oxidative PPP| C[Enter Oxidative Phase]
    B -->|Glycolysis| D[Phosphoglucose Isomerase]
    B -->|Both| E[Flux Split]
    
    %% Oxidative Phase Step 1
    C --> F["Zwf: G6P Dehydrogenase"]
    F --> G{AND: NADP+<br/>Available?}
    G -->|No| H[\Enzyme Inhibited/]
    G -->|Yes| I[6-Phosphogluconolactone]
    I --> J[NADPH #1 Produced]
    
    %% Oxidative Phase Step 2
    I --> K["Pgl: 6-Phosphogluconolactonase"]
    K --> L[6-Phosphogluconate]
    
    %% Oxidative Phase Step 3
    L --> M["Gnd: 6PG Dehydrogenase"]
    M --> N{AND: NADP+<br/>Available?}
    N -->|No| O[\Enzyme Inhibited/]
    N -->|Yes| P[Ribulose-5-Phosphate]
    P --> Q[NADPH #2 Produced]
    P --> R[CO2 Released]
    
    %% Branch Point
    P --> S{OR: Cellular<br/>Need?}
    S -->|NADPH for Biosynthesis| T[End Oxidative - NADPH Output]
    S -->|Ribose-5-P for Nucleotides| U[Enter Isomerization]
    S -->|Recycle to Glycolysis| V[Enter Non-oxidative Phase]
    
    %% Isomerization
    U --> W["Rpe: Ru5P Epimerase"]
    W --> X[Xylulose-5-Phosphate]
    U --> Y["Rpi: Ru5P Isomerase"]
    Y --> Z[Ribose-5-Phosphate]
    
    %% OR Gate: Nucleotide Synthesis
    Z --> AA{OR: Which<br/>Nucleotide?}
    AA -->|Purine| AB[PRPP Synthetase]
    AA -->|Pyrimidine| AC[UMP Synthesis]
    AA -->|Histidine| AD[Histidine Biosynthesis]
    AB --> AE([Nucleotide Biosynthesis])
    AC --> AE
    AD --> AE
    
    %% Non-oxidative Phase
    V --> AF[Mix of Sugar Phosphates]
    X --> AF
    Z --> AF
    
    %% Transketolase Reaction 1
    AF --> AG["TktA: Transketolase"]
    AG --> AH[/X5P + R5P → S7P + G3P/]
    AH --> AI[Sedoheptulose-7-P]
    AH --> AJ[Glyceraldehyde-3-P]
    
    %% Transaldolase Reaction
    AI --> AK["TalB: Transaldolase"]
    AJ --> AK
    AK --> AL[S7P + G3P → F6P + E4P]
    AL --> AM[Fructose-6-Phosphate]
    AL --> AN[Erythrose-4-Phosphate]
    
    %% Transketolase Reaction 2
    AN --> AO["/TktB: Transketolase"]
    X --> AO
    AO --> AP[E4P + X5P → F6P + G3P]
    AP --> AQ[Fructose-6-Phosphate #2]
    AP --> AR[Glyceraldehyde-3-P #2]
    
    %% Return to Glycolysis
    AM --> AS{OR: Which<br/>Fate?}
    AQ --> AS
    AS -->|Lower Glycolysis| AT[Fructose-1,6-Bisphosphate]
    AS -->|Gluconeogenesis| AU[Glucose-6-Phosphate]
    
    AJ --> AV{OR: Glycolysis<br/>Fate?}
    AR --> AV
    AV -->|Pyruvate| AW[Lower Glycolysis]
    AV -->|Recycle| AU
    
    %% Operational Modes
    AT --> AX["Mode 1: Max NADPH"]
    AU --> AY["Mode 2: Max Ribose-5-P"]
    AU --> AZ["Mode 3: Recycle to Glycolysis"]
    
    %% Outputs
    T --> BA([NADPH for Fatty Acid Synthesis])
    J --> BA
    Q --> BA
    AW --> BB([Pyruvate to TCA])
    AX --> BB
    AY --> BC([Pentose Sugars])
    AZ --> BD([Glycolytic Intermediates])
    
