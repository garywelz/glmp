graph TD
    %% Phosphate Status Input
    A[Low External Phosphate] --> B[Phosphate Limitation Signal]
    C[Phosphate Depletion] --> B
    
    %% PstSCAB Transport System
    B --> D[PstS Periplasmic Binding Protein]
    D --> E[Low Phosphate Binding]
    E --> F[PstS Conformational Change]
    F --> G[PstCAB Transport Complex]
    G --> H[Low Phosphate Transport]
    
    %% PhoR Sensor Activation
    H --> I[PstSCAB-PhoR Interaction]
    I --> J[PhoR Sensor Kinase]
    
    %% Decision: Phosphate Limitation?
    J --> K{Low Phosphate?}
    
    %% Low Phosphate Path - PhoR Activation
    K -->|Yes| L[PhoR Kinase Activity]
    L --> M[ATP Binding]
    M --> N[PhoR Autophosphorylation]
    N --> O[PhoR-P Formation]
    
    %% Phosphotransfer to PhoB
    O --> P[Phosphotransfer to PhoB]
    P --> Q[PhoB-P Active Form]
    Q --> R[PhoB-P Dimerization]
    R --> S[DNA Binding Competent]
    
    %% Decision: PhoB-P Levels
    S --> T{High PhoB-P?}
    
    %% AND Gate 1: phoA Activation
    T -->|Yes| ANDGATE1{PhoB-P AND<br/>phoA Pho Box?}
    U[phoA Promoter Accessibility] --> ANDGATE1
    
    %% Alkaline Phosphatase Expression
    ANDGATE1 -->|Yes| V[PhoB-P Binds phoA Pho Box]
    V --> W[phoA Transcription]
    W --> X[phoA mRNA]
    X --> Y[PhoA Translation]
    Y --> Z[Alkaline Phosphatase]
    Z --> AA[Enzyme Export]
    AA --> AB[Periplasmic PhoA]
    AB --> AC[Organic Phosphate Hydrolysis]
    AC --> AD[Phosphate Liberation]
    AD --> AE[Phosphate Scavenging]
    
    %% Alternative Transport Systems
    S --> AF[PhoB-P Binds Multiple Pho Boxes]
    AF --> AG[phoE Gene Activation]
    AG --> AH[PhoE Porin Expression]
    AH --> AI[Phosphate Anion Transport]
    
    AF --> AJ[ugpBAECQ Operon Activation]
    AJ --> AK[Glycerol-3-P Transport System]
    AK --> AL[Alternative Phosphate Sources]
    
    %% AND Gate 2: pstSCAB Repression
    S --> ANDGATE2{PhoB-P AND<br/>pstS Pho Box?}
    AM[pstS Promoter] --> ANDGATE2
    ANDGATE2 -->|Yes| AN[Paradoxical pstS Activation]
    AN --> AO[More PstS Protein]
    AO --> D
    
    %% Phosphonate Utilization
    AF --> AP[phnCDE Operon Activation]
    AP --> AQ[/Phosphonate Degradation Enzymes/]
    AQ --> AR[Phosphonate Breakdown]
    AR --> AS[Phosphate from Phosphonates]
    
    %% High Phosphate Path
    K -->|No| AT[High Phosphate]
    AT --> AU[PstSCAB High Affinity Transport]
    AU --> AV[Phosphate Accumulation]
    AV --> AW[PhoR Phosphatase Activity]
    AW --> AX[PhoB-P Dephosphorylation]
    AX --> AY[PhoB Inactive]
    AY --> AZ[Low Pho Gene Expression]
    AZ --> BA[Basal State]
    
    %% Phosphate Homeostasis
    AE --> BB[Cellular Phosphate Restored]
    AI --> BB
    AL --> BB
    AS --> BB
    BB --> BC[Feedback to PhoR]
    BC --> AW
    
    %% System Outputs
    BA --> BD[Phosphate-Sufficient Growth]
    BB --> BE[Phosphate Homeostasis]
    AE --> BF[Starvation Adaptation]
    
