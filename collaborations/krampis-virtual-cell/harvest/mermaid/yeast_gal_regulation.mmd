graph TD
    %% Environmental Inputs
    A[Galactose in Environment] --> B[Galactose Transport]
    C[Glucose in Environment] --> D[Glucose Transport]
    
    %% Glucose Repression Pathway
    D --> E[High Glucose Levels]
    E --> F[cAMP Levels Low]
    F --> G[\PKA Inactive/]
    G --> H{Glucose Present?}
    
    %% Glucose YES path - Catabolite Repression
    H -->|Yes| I[Mig1 Dephosphorylated]
    I --> J[Mig1 Nuclear Import]
    J --> K[Mig1 Binds GAL Promoters]
    K --> L[\Chromatin Remodeling Blocked/]
    L --> M[\GAL Genes Repressed/]
    M --> N[No Galactose Metabolism]
    
    %% Glucose NO path - Derepression
    H -->|No| O[PKA Active]
    O --> P[Mig1 Phosphorylated]
    P --> Q[Mig1 Nuclear Export]
    Q --> R[GAL Promoters Accessible]
    
    %% Galactose Sensing
    B --> S[Galactose Inside Cell]
    S --> T{Galactose Present?}
    
    %% No Galactose path
    T -->|No| U[\Gal3p Inactive/]
    U --> V[Gal80p Binds Gal4p]
    V --> W[\Gal4p Inhibited/]
    W --> X[No GAL Activation]
    X --> Y[Basal GAL Expression]
    
    %% Galactose YES path
    T -->|Yes| Z[Galactose Binds Gal3p]
    Z --> AA[Gal3p Conformational Change]
    AA --> AB[Gal3p-Galactose-ATP Complex]
    AB --> AC[Gal3p Binds Gal80p]
    AC --> AD[Gal80p Released from Gal4p]
    
    %% AND Gate: Activation requires BOTH no glucose AND galactose
    R --> ANDGATE1{No Glucose AND<br/>Gal80p Released?}
    AD --> ANDGATE1
    
    ANDGATE1 -->|Yes| AE[Gal4p Activation Domain Exposed]
    ANDGATE1 -->|No| Y
    
    AE --> AF[Gal4p Recruits Mediator]
    AF --> AG[/SAGA Complex Recruitment/]
    AG --> AH[Histone Acetylation]
    AH --> AI[Chromatin Opening]
    AI --> AJ[TFIID Recruitment]
    AJ --> AK[RNA Pol II Recruitment]
    AK --> AL[/Strong GAL Transcription/]
    
    %% Gene Expression
    AL --> AM[/GAL1 mRNA Synthesis/]
    AL --> AN[GAL7 mRNA Synthesis]
    AL --> AO[GAL10 mRNA Synthesis]
    AL --> AP[GAL2 mRNA Synthesis]
    
    %% Translation
    AM --> AQ[Gal1p Translation]
    AN --> AR[Gal7p Translation]
    AO --> AS[Gal10p Translation]
    AP --> AT[Gal2p Translation]
    
    %% Enzyme Functions
    AQ --> AU[/Galactokinase Active/]
    AR --> AV[Galactose-1-P Uridylyltransferase]
    AS --> AW[/UDP-Glucose 4-Epimerase/]
    AT --> AX[Galactose Permease]
    
    %% Metabolic Pathway
    AU --> AY[Galactose to Gal-1-P]
    AV --> AZ[Gal-1-P to UDP-Galactose]
    AW --> BA[UDP-Galactose to UDP-Glucose]
    AX --> BB[Enhanced Galactose Uptake]
    
    %% Products and Feedback
    BA --> BC[UDP-Glucose Pool]
    BC --> BD[Glycolysis Entry]
    BD --> BE[Energy Production]
    AY --> BF[Galactose-1-Phosphate Pool]
    BF --> AZ
    BB --> BG[Increased Galactose Influx]
    BG --> BH[Sustained GAL Induction]
    
    %% System States
    BE --> BI[Cell Growth on Galactose]
    N --> BJ[Cell Growth on Glucose]
    Y --> BK[Low Galactose Utilization]
    
