    %% Heat Stress
    A[Temperature Increase] --> B{OR: Stress<br/>Level?}
    B -->|Normal 37°C| C(\1)
    B -->|Heat Shock >42°C| D[Protein Stress]
    
    %% Normal Conditions
    C --> E[σ32 RpoH Basal Level]
    E --> F[DnaK/DnaJ Chaperones Available]
    F --> G[DnaK Binds σ32]
    G --> H[DnaJ Stimulates ATPase]
    H --> I[DnaK-ADP-σ32 Complex]
    I --> J[GrpE Nucleotide Exchange]
    J --> K[DnaK Releases σ32]
    K --> L[FtsH Protease Access]
    L --> M[/σ32 Degradation/]
    M --> N[Low σ32 t1/2 ~1 min]
    N --> O([Basal Heat Shock Genes])
    
    %% Heat Shock - Protein Misfolding
    D --> P[Proteins Unfold]
    P --> Q[Hydrophobic Residues Exposed]
    Q --> R[Misfolded Protein Accumulation]
    
    %% Chaperone Titration
    R --> S[DnaK/DnaJ Bind Misfolded Proteins]
    S --> T[Chaperones Sequestered]
    T --> U[/σ32 Not Bound by DnaK/]
    U --> V[σ32 Stabilized]
    V --> W[σ32 Accumulates]
    
    %% σ32-RNAP Complex
    W --> X[σ32 Binds Core RNAP]
    X --> Y{AND: σ32 + Core<br/>RNAP?}
    Y -->|No| Z[/No Transcription/]
    Y -->|Yes| AA[Eσ32 Holoenzyme]
    
    %% Heat Shock Promoter Recognition
    AA --> AB[Eσ32 Recognizes Heat Shock Promoters]
    AB --> AC[-35 CTTGAAA]
    AC --> AD[-10 CCCCATNT]
    AD --> AE[Heat Shock Gene Transcription]
    
    %% OR Gate: Which Heat Shock Gene?
    AE --> AF{OR: Which<br/>Gene Class?}
    AF -->|dnaK/dnaJ/grpE| AG[DnaK Chaperone System]
    AF -->|groEL/groES| AH[GroEL Chaperonin System]
    AF -->|clpB| AI[ClpB Disaggregase]
    AF -->|lon/ftsH| AJ[ATP-Dependent Proteases]
    AF -->|htpG| AK[HtpG Hsp90 Homolog]
    AF -->|ibpAB| AL[Small Heat Shock Proteins]
    
    %% DnaK System Upregulation
    AG --> AM[DnaK/DnaJ/GrpE Production]
    AM --> AN[Enhanced Chaperone Capacity]
    AN --> AO[Protein Refolding]
    
    %% GroEL System
    AH --> AP[GroEL/ES Production]
    AP --> AQ[GroEL Barrel Complex]
    AQ --> AR[Anfinsen Cage]
    AR --> AS[Substrate Encapsulation]
    AS --> AT[ATP-Dependent Folding]
    AT --> AO
    
    %% ClpB Disaggregase
    AI --> AU[ClpB AAA+ ATPase]
    AU --> AV[Aggregate Recognition]
    AV --> AW{AND: ClpB + DnaK<br/>Cooperation?}
    AW -->|No| AX[Aggregates Persist]
    AW -->|Yes| AY[Aggregate Disassembly]
    AY --> AZ[Proteins Extracted]
    AZ --> AO
    
    %% Proteolytic Quality Control
    AJ --> BA[Lon/FtsH Proteases]
    BA --> BB[Recognize Misfolded Proteins]
    BB --> BC[Irreversibly Damaged]
    BC --> BD[/Protease Degradation/]
    BD --> BE[Amino Acids Recycled]
    
    %% Negative Feedback
    AM --> BF[Newly Synthesized DnaK]
    BF --> BG[Excess Chaperone Capacity]
    BG --> BH[DnaK Rebinds σ32]
    BH --> BI[σ32 Destabilization]
    BI --> BJ[/FtsH Degrades σ32/]
    BJ --> BK[σ32 Levels Drop]
    BK --> BL[Heat Shock Response OFF]
    
    %% Resolution
    AO --> BM[Proteins Refolded]
    BE --> BM
    BM --> BN[Proteome Restored]
    BN --> BO[Temperature Normalized]
    BO --> BP["(\1)"]
    
    AX --> BQ[Inclusion Bodies]
    BQ --> BR[Permanent Aggregates]
    BR --> BS([Cell Death])
    
    Z --> BT([No Response])
    
