graph TD
    %% Central Metabolism Sources
    A(\1) --> B[3-Phosphoglycerate]
    A --> C[Phosphoenolpyruvate PEP]
    A --> D(\1)
    E[TCA Cycle] --> F[α-Ketoglutarate]
    E --> G(\1)
    H[Pentose Phosphate] --> I[Ribose-5-Phosphate]
    I --> J(\1)
    H --> K[Erythrose-4-Phosphate E4P]
    
    %% OR Gate 1: Which Amino Acid Family?
    L[Amino Acid Biosynthesis] --> M{OR: Which<br/>Precursor?}
    M -->|α-KG| N[Glutamate Family]
    M -->|OAA| O[Aspartate Family]
    M -->|3-PG| P[Serine Family]
    M -->|PEP+E4P| Q{Aromatic: PEP AND E4P}
    M -->|Pyruvate| R[Pyruvate Family]
    M -->|PRPP| S(\1)
    
    %% Glutamate Family
    F --> N
    N --> T["GltA: α-KG + NH3 → Glutamate"]
    T --> U[Glutamate Central Hub]
    
    U --> V{OR: Glu<br/>Branch?}
    V -->|GlnA| W[Glu + NH3 → Glutamine]
    V -->|ProABC| X[Glu → Proline 5 steps]
    V -->|ArgABCDEFGH| Y[Glu → Arginine 8 steps]
    
    W --> Z(\1)
    X --> AA(\1)
    Y --> AB(\1)
    
    %% Aspartate Family
    G --> O
    O --> AC["AspC: OAA + Glu → Aspartate"]
    AC --> AD[Aspartate Hub]
    
    AD --> AE{OR: Asp<br/>Branch?}
    AE -->|AsnAB| AF[Asp + Gln → Asparagine]
    AE -->|MetLABCE| AG[Asp → Methionine via Homoserine]
    AE -->|ThrABC| AH[Asp → Threonine]
    AE -->|LysC-DapF| AI[Asp → Lysine via DAP]
    
    AF --> AJ(\1)
    AG --> AK(\1)
    AH --> AL(\1)
    AL --> AL_OR{Thr Path?}
    AL_OR -->|To Ile| AM["IlvA: Thr → Isoleucine"]
    AM --> AN(\1)
    AI --> AO(\1)
    
    %% Serine Family
    B --> P
    P --> AP["SerA: 3-PG → 3-Phosphohydroxypyruvate"]
    AP --> AQ["SerC: Transamination"]
    AQ --> AR["SerB: Dephosphorylation"]
    AR --> AS(\1)
    
    AS --> AT{OR: Ser<br/>Branch?}
    AT -->|GlyA| AU[Ser → Glycine + C1 unit]
    AT -->|CysE+CysK| AV[Ser → Cysteine]
    
    AU --> AW(\1)
    AV --> AX(\1)
    
    %% Aromatic Family
    C --> Q
    K --> Q
    Q --> AY["AroABCDEF: Shikimate Pathway"]
    AY --> AZ[Chorismate Common Intermediate]
    
    AZ --> BA{OR: Aromatic<br/>Branch?}
    BA -->|PheA+TyrA| BB[Phe/Tyr Pathway]
    BA -->|TrpABCDE| BC[Trp Pathway 5 steps]
    
    BB --> BD{OR: Prephenate<br/>Branch?}
    BD -->|PheA| BE[Prephenate → Phenylalanine]
    BD -->|TyrA| BF[Prephenate → Tyrosine]
    
    BE --> BG[Phenylalanine]
    BF --> BH(\1)
    BC --> BI(\1)
    
    %% Pyruvate Family
    D --> R
    R --> BJ[Pyruvate Hub]
    
    BJ --> BK{OR: Pyr<br/>Branch?}
    BK -->|AlaA| BL[Pyr + Glu → Alanine]
    BK -->|IlvBCDE| BM[Pyr → Valine 4 steps]
    
    BL --> BN(\1)
    BM --> BO(\1)
    BO --> BO_OR{Val Path?}
    BO_OR -->|To Leu| BP["LeuABCD: Val → Leucine"]
    BP --> BQ(\1)
    
    %% Histidine Pathway
    J --> S
    S --> BR["HisABCDEFGH: 10 steps"]
    BR --> BS(\1)
    
    %% Feedback Regulation
    Z --> BT{High Gln?}
    BT -->|Yes| BU[GlnA Feedback Active]
    BU --> BV[/Gln Synthesis Reduced/]
    
    AB --> BW[ArgR Repressor Protein]
    BW --> BX[/arg Operon Repression/]
    
    BI --> BY[TrpR Repressor Protein]
    BY --> BZ[/trp Operon Repression/]
    
    %% Outputs
    BN --> CA([20 Amino Acids])
    Z --> CA
    AA --> CA
    AB --> CA
    AJ --> CA
    AK --> CA
    AL --> CA
    AN --> CA
    AO --> CA
    AW --> CA
    AX --> CA
    BG --> CA
    BH --> CA
    BI --> CA
    BO --> CA
    BQ --> CA
    BS --> CA
    
    CA --> CB[Protein Synthesis]
    CB --> CC([Cell Growth])
    
