graph TD
    %% Cell Wall Stress
    A[Cell Wall Stress] --> B{OR: Stress<br/>Type?}
    B -->|Osmotic| C[Hypoosmotic Shock]
    B -->|Heat| D[Temperature Stress]
    B -->|Chemical| E[Cell Wall Damaging Agents]
    B -->|Growth| F[Bud Formation]
    
    C --> G[Cell Wall Stretching]
    D --> G
    E --> G
    F --> G
    
    %% Surface Sensors
    G --> H{OR: Which<br/>Sensor?}
    H -->|Wsc Family| I[Wsc1/2/3 Sensors]
    H -->|Mid2| J[Mid2 Sensor]
    H -->|Mtl1| K[Mtl1 Sensor]
    
    I --> L[Wsc Cysteine-Rich Domain]
    L --> M[Conformational Change]
    J --> M
    K --> M
    
    %% Rho1 Activation
    M --> N[Rom1/2 GEF Recruitment]
    N --> O[Rho1-GDP at Membrane]
    O --> P[Rom1/2 Catalyzes GTP Exchange]
    P --> Q[Rho1-GTP Formation]
    
    %% Rho1 Dual Function
    Q --> R{OR: Rho1-GTP<br/>Target?}
    R -->|Pkc1 MAPK| S[Pkc1 Kinase Activation]
    R -->|Glucan Synthase| T[Fks1/2 β-1,3-Glucan Synthase]
    
    %% Direct Glucan Synthesis
    T --> U[Rho1 Binds Fks1]
    U --> V{AND: Fks1 + Fks2<br/>Catalytic Subunits?}
    V -->|No| W[Reduced Synthesis]
    V -->|Yes| X[β-1,3-Glucan Polymerization]
    X --> Y[Cell Wall Thickening]
    Y --> Z[Immediate Repair]
    
    %% Pkc1 Activation
    S --> AA[Pkc1 Protein Kinase C]
    AA --> AB{AND: Phosphatidylserine<br/>AND DAG?}
    AB -->|No| AC[\Pkc1 Inactive/]
    AB -->|Yes| AD[Pkc1 Membrane Recruitment]
    
    AD --> AE[Pkc1 Autophosphorylation]
    AE --> AF[Pkc1 Active]
    
    %% MAPK Cascade - MAPKKK
    AF --> AG[Bck1 MAPKKK]
    AG --> AH[Pkc1 Phosphorylates Bck1]
    AH --> AI[Bck1 Activated]
    
    %% MAPK Cascade - MAPKK
    AI --> AJ{OR: Mkk1<br/>or Mkk2?}
    AJ -->|Mkk1| AK[Mkk1 MAPKK]
    AJ -->|Mkk2| AL[Mkk2 MAPKK]
    
    AK --> AM[Bck1 Phosphorylates Mkk1]
    AL --> AN[Bck1 Phosphorylates Mkk2]
    AM --> AO[Mkk1/2 Active]
    AN --> AO
    
    %% MAPK Cascade - MAPK
    AO --> AP[Slt2/Mpk1 MAPK]
    AP --> AQ[Mkk1/2 Dual Phosphorylation]
    AQ --> AR[Slt2-PP Active]
    
    %% Nuclear Translocation
    AR --> AS[Slt2 Nuclear Import]
    AS --> AT[Active MAPK in Nucleus]
    
    %% Transcription Factor Activation
    AT --> AU{OR: Which<br/>TF Target?}
    AU -->|Rlm1| AV[Rlm1 Transcription Factor]
    AU -->|SBF| AW[Swi4/Swi6 SBF Complex]
    
    %% Rlm1 Pathway
    AV --> AX[Slt2 Phosphorylates Rlm1]
    AX --> AY[Rlm1 Activated]
    AY --> AZ{AND: Rlm1<br/>Binds DNA?}
    AZ -->|No| BA[/No Transcription/]
    AZ -->|Yes| BB[Rlm1 Binds CWI Elements]
    
    BB --> BC{OR: Which<br/>CWI Gene?}
    BC -->|FKS2| BD[FKS2 Glucan Synthase]
    BC -->|SED1| BE[SED1 Cell Wall Protein]
    BC -->|CRH1| BF[CRH1 Chitin Transglycosylase]
    BC -->|PIR| BG[PIR Proteins]
    
    BD --> BH[Enhanced Glucan Synthesis]
    BE --> BI[Cell Wall Proteins]
    BF --> BJ[Chitin Remodeling]
    BG --> BI
    
    BH --> BK[Cell Wall Biosynthesis]
    BI --> BK
    BJ --> BK
    BK --> BL([Reinforced Cell Wall])
    
    %% SBF Pathway
    AW --> BM[Slt2 Phosphorylates Swi4]
    BM --> BN[SBF Activated]
    BN --> BO[Cell Cycle Gene Expression]
    BO --> BP[CLN1/2 Cyclins]
    BP --> BQ[G1/S Transition]
    BQ --> BR[Cell Division]
    BR --> BS([Growth Resume])
    
    %% Feedback Regulation
    AR --> BT[Msg5 Phosphatase]
    BT --> BU[Msg5 Dephosphorylates Slt2]
    BU --> BV[Slt2 Inactivation]
    BV --> BW[Signaling Attenuation]
    
    Q --> BX[Bem2 GAP]
    BX --> BY[Rho1-GTP Hydrolysis]
    BY --> BZ(\1)
    BZ --> CA[\Inactive State/]
    
    %% Actin Cytoskeleton
    Q --> CB[Bni1/Bnr1 Formins]
    CB --> CC[Actin Polymerization]
    CC --> CD[Polarized Growth]
    CD --> CE[Bud Site Selection]
    CE --> CF([Cell Morphogenesis])
    
    Z --> CG([Stress Resolved])
    BL --> CG
    
