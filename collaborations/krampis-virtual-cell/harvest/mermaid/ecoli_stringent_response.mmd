graph TD
    %% Amino Acid Starvation Input
    A[Amino Acid Limitation] --> B[Reduced Charged tRNA Pool]
    C[Translation Stress] --> B
    
    %% tRNA Charging Imbalance
    B --> D[Increased Uncharged tRNA]
    D --> E[tRNA Charging Failure]
    E --> F[Ribosome Stalling]
    
    %% Decision: Uncharged tRNA Present?
    F --> G{Uncharged tRNA<br/>at A-site?}
    
    %% AND Gate: RelA Activation
    G -->|Yes| ANDGATE1{Uncharged tRNA AND<br/>Ribosome Stalled?}
    H[Ribosomal A-site] --> ANDGATE1
    
    %% RelA Activation
    ANDGATE1 -->|Yes| I[RelA Binds Ribosome]
    I --> J[RelA Conformational Change]
    J --> K[RelA Synthetase Activation]
    
    %% (p)ppGpp Synthesis
    K --> L[ATP Substrate Binding]
    L --> M[GTP/GDP Substrate Binding]
    M --> N[Phosphotransfer Reaction]
    N --> O[pppGpp Synthesis]
    N --> P[ppGpp Synthesis]
    O --> Q[ppGpp/pppGpp Accumulation]
    P --> Q
    
    %% Decision: ppGpp Levels
    Q --> R{High ppGpp?}
    
    %% AND Gate: RNAP Regulation
    R -->|Yes| ANDGATE2{ppGpp AND<br/>DksA Present?}
    S[DksA Cofactor] --> ANDGATE2
    
    %% RNAP-ppGpp Complex
    ANDGATE2 -->|Yes| T[ppGpp Binds RNAP]
    T --> U[DksA Binds RNAP]
    U --> V[RNAP Conformational Change]
    
    %% Stable RNA Repression
    V --> W[rRNA Promoter Destabilization]
    V --> X[tRNA Promoter Destabilization]
    W --> Y[Reduced rRNA Transcription]
    X --> Z[Reduced tRNA Transcription]
    Y --> AA[Decreased Ribosome Synthesis]
    Z --> AB[Decreased Translation Capacity]
    AA --> AC[Growth Slowdown]
    AB --> AC
    
    %% Amino Acid Biosynthesis Activation
    V --> AD[Amino Acid Operon Activation]
    AD --> AE[trp Operon Induction]
    AD --> AF[his Operon Induction]
    AD --> AG[ile Operon Induction]
    AE --> AH[Tryptophan Biosynthesis]
    AF --> AI[Histidine Biosynthesis]
    AG --> AJ[Isoleucine Biosynthesis]
    
    %% Stress Gene Activation
    V --> AK[Stress Response Gene Activation]
    AK --> AL[rpoS Induction]
    AK --> AM[Stationary Phase Genes]
    AL --> AN[σS Alternative Sigma Factor]
    AN --> AO[General Stress Response]
    AM --> AP[Metabolic Adaptation]
    
    %% Amino Acid Pool Restoration
    AH --> AQ[Amino Acid Pool Increase]
    AI --> AQ
    AJ --> AQ
    AQ --> AR[tRNA Charging Restored]
    AR --> AS[Translation Resumes]
    
    %% ppGpp Degradation
    AS --> AT[RelA Dissociates from Ribosome]
    AT --> AU[SpoT Hydrolase Activity]
    AU --> AV[/ppGpp Degradation/]
    AV --> AW[Basal ppGpp Levels]
    AW --> AX[rRNA Transcription Restored]
    AX --> AY[Growth Resumption]
    
    %% Normal Growth Path
    G -->|No| AZ[Normal tRNA Charging]
    AZ --> BA[Low ppGpp Levels]
    BA --> BB[High rRNA/tRNA Transcription]
    BB --> BC[Rapid Ribosome Synthesis]
    BC --> BD[Fast Growth]
    
    %% System Outputs
    AC --> BE[Survival Mode]
    AO --> BF[Stress Resistance]
    AP --> BG[Metabolic Remodeling]
    AY --> BH[Growth Recovery]
    BD --> BI[Optimal Growth]
    
