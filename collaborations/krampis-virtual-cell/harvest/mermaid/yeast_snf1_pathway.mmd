graph TD
    %% Glucose Sensing
    A[Glucose Level] --> B{OR: Glucose<br/>Status?}
    B -->|High| C[/Glucose Repression/]
    B -->|Low| D[Energy Stress]
    
    %% High Glucose - Snf1 Inactive
    C --> E[High ATP/AMP Ratio]
    E --> F[Reg1 Phosphatase Active]
    F --> G[Reg1 Dephosphorylates Snf1]
    G --> H[/Snf1 Inactive/]
    H --> I[/Mig1 Repressor Active/]
    I --> J[/Alternative Carbon Genes Repressed/]
    
    %% Low Glucose - Snf1 Activation
    D --> K[Low ATP/AMP Ratio]
    K --> L[AMP/ADP Accumulation]
    L --> M[Snf4 Binds AMP]
    
    M --> N{AND: Snf1/Snf4/β<br/>Complex?}
    N -->|No| O[No Activation]
    N -->|Yes| P[Snf1 Heterotrimer]
    
    P --> Q{OR: Which<br/>β-Subunit?}
    Q -->|Gal83| R[Cytoplasmic Localization]
    Q -->|Sip1| S[Stress Granules]
    Q -->|Sip2| T[Vacuolar Membrane]
    
    %% Upstream Kinase Activation
    R --> U{OR: Which<br/>Upstream Kinase?}
    S --> U
    T --> U
    
    U -->|Sak1| V[Sak1 Kinase]
    U -->|Elm1| W[Elm1 Kinase]
    U -->|Tos3| X[Tos3 Kinase]
    
    V --> Y[Sak1 Phosphorylates Snf1-Thr210]
    W --> Y
    X --> Y
    Y --> Z[Snf1 Activated]
    
    %% Mig1 Regulation
    Z --> AA[Snf1 Phosphorylates Mig1]
    AA --> AB[Mig1-P Nuclear Export]
    AB --> AC[Mig1 Cytoplasmic]
    AC --> AD[\SUC2/GAL Genes Derepressed/]
    
    AD --> AE{OR: Which Gene<br/>Class?}
    AE -->|SUC2| AF[Invertase - Sucrose Use]
    AE -->|GAL1-10| AG[Galactose Metabolism]
    AE -->|MAL| AH[/Maltose Utilization/]
    
    AF --> AI[Sucrose Catabolism]
    AG --> AJ[/Galactose Catabolism/]
    AH --> AK[Maltose Catabolism]
    
    AI --> AL([Alternative Carbon Source Use])
    AJ --> AL
    AK --> AL
    
    %% Adr1 Activation
    Z --> AM[Snf1 Phosphorylates Adr1]
    AM --> AN[Adr1-P Nuclear Import]
    AN --> AO[Adr1 Active TF]
    AO --> AP[ADH2/POX1/CTA1 Expression]
    AP --> AQ[Ethanol Oxidation]
    AQ --> AR[Peroxisomal Fatty Acid β-Oxidation]
    AR --> AS([Gluconeogenesis])
    
    %% Cat8 Activation
    Z --> AT[Snf1 Activates Cat8]
    AT --> AU[Cat8 TF Nuclear]
    AU --> AV[Gluconeogenic Genes]
    AV --> AW[FBP1/PCK1/ICL1]
    AW --> AS
    
    %% Metabolic Enzyme Regulation
    Z --> AX{OR: Which<br/>Enzyme?}
    AX -->|Acc1| AY[Acc1 Acetyl-CoA Carboxylase]
    AX -->|Hmg1| AZ[Hmg1 HMG-CoA Reductase]
    
    AY --> BA[Snf1 Phosphorylates Acc1]
    BA --> BB[/Acc1 Inhibited/]
    BB --> BC[Fatty Acid Synthesis Reduced]
    
    AZ --> BD[Snf1 Phosphorylates Hmg1]
    BD --> BE[/Hmg1 Inhibited/]
    BE --> BF[Sterol Synthesis Reduced]
    
    BC --> BG[Energy Conservation]
    BF --> BG
    BG --> BH([Metabolic Remodeling])
    
    %% Integration with TOR
    D --> BI[/TORC1 Inhibition/]
    BI --> BJ[Autophagy Induction]
    Z --> BJ
    BJ --> BK[/Protein Degradation/]
    BK --> BL[Amino Acid Recycling]
    BL --> BM["(\1)"]
    
    %% Feedback Regulation
    Z --> BN[Snf1 Autophosphorylation]
    BN --> BO[Enhanced Activity]
    BO --> Z
    
    AL --> BP[Glucose Restored]
    BP --> BQ[ATP/AMP Ratio Increases]
    BQ --> F
    
