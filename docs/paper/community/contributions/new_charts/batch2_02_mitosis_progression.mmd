    S --> T[Spindle Elongation]
    T --> U[Telophase Initiation]
    U --> V[Nuclear Envelope Reformation]
    V --> W[Chromosome Decondensation]
    W --> X[Mitosis Complete]
    
    %% Key proteins
    Y[Condensin] --> C
    Z[Cohesin] --> D
    AA[Separase] --> O
