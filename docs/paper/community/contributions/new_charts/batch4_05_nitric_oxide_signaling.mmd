    %% Termination
    J --> N[NO Oxidation]
    N --> O[NO2/NO3 Formation]
    O --> P[Signal Termination]
    
    %% Feedback regulation
    J --> Q[Phosphatase Activation]
    Q --> R[Protein Dephosphorylation]
    R --> S[Response Termination]
    
    %% Key proteins
    T[NOS] --> B
    U[sGC] --> F
    V[PKG] --> H
    W[L-Arginine] --> C
    X[cGMP] --> G
    Y[Phosphatases] --> Q
    
