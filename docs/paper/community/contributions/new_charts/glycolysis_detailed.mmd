flowchart TD
    A[Glucose] --> B[Glucose Transport]
    B --> C[Hexokinase]
    C --> D[Glucose-6-P]
    D --> E[Phosphoglucose Isomerase]
    E --> F[Fructose-6-P]
    F --> G[Phosphofructokinase]
    G --> H[Fructose-1,6-BP]
    H --> I[Aldolase]
    I --> J[Glyceraldehyde-3-P + DHAP]
    J --> K[Triose Phosphate Isomerase]
    K --> L[Glyceraldehyde-3-P]
    L --> M[GAPDH]
    M --> N[1,3-Bisphosphoglycerate]
    N --> O[Phosphoglycerate Kinase]
    O --> P[3-Phosphoglycerate]
    P --> Q[Phosphoglycerate Mutase]
    Q --> R[2-Phosphoglycerate]
    R --> S[Enolase]
    S --> T[Phosphoenolpyruvate]
    T --> U[Pyruvate Kinase]
    U --> V[Pyruvate]
    
    %% Energy production
    O --> W[ATP Production]
    M --> X[NADH Production]
    
    %% Regulation
    Y[High Energy] --> Z[PFK Inhibition]
    Z --> AA[Glycolysis Slowdown]
    
    BB[Low Energy] --> CC[PFK Activation]
    CC --> DD[Glycolysis Acceleration]
    
    %% Alternative fates
    V --> EE[Pyruvate Decarboxylase]
    EE --> FF[Acetaldehyde]
    FF --> GG[Alcohol Dehydrogenase]
    GG --> HH[Ethanol]
    
    V --> II[Pyruvate Dehydrogenase]
    II --> JJ[Acetyl-CoA]
    JJ --> KK[TCA Cycle]
    
    %% Key proteins
    LL[Glk1] --> B
    MM[Hxk1/2] --> C
    NN[Pfk1] --> G
    OO[Pyk1] --> U
    PP[Adh1] --> GG
    
    %% Styling
    classDef substrate fill:#ffcccc
    classDef enzyme fill:#ccffcc
    classDef intermediate fill:#ccccff
    classDef energy fill:#ffffcc
    classDef protein fill:#ffccff
    
    class A substrate
    class C,E,G,I,K,M,O,Q,S,U enzyme
    class D,F,H,J,L,N,P,R,T,V intermediate
    class W,X energy
    class LL,MM,NN,OO,PP protein
