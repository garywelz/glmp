  "pseudocode": {
    "high_level": [
      "FUNCTION glucose_repression(glucose_concentration):",
      "  // Main decision point",
      "  IF (glucose_concentration > THRESHOLD):",
      "    // High glucose pathway",
      "    CALL repress_alternative_carbon_genes()",
      "    CALL activate_glucose_metabolism()",
      "    RETURN fermentation_active",
      "  ELSE:",
      "    // Low glucose pathway",
      "    CALL activate_alternative_carbon_genes()",
      "    CALL activate_respiration()",
      "    RETURN respiration_active",
      "",
      "FUNCTION repress_alternative_carbon_genes():",
      "  // Sensor activation",
      "  sensor_signal = glucose_sensors.sense(glucose)",
      "  ",
      "  // AND gate - both conditions required",
      "  IF (glucose_high AND sensor_activated):",
      "    // Inactivate Snf1 kinase (NOT gate)",
      "    snf1.state = INACTIVE  // via Reg1 phosphatase",
      "    ",
      "    // Without Snf1, Mig1 remains dephosphorylated",
      "    mig1.phosphorylation = LOW",
      "    ",
      "    // Nuclear import",
      "    mig1.localization = NUCLEUS",
      "    ",
      "    // DNA binding and repression",
      "    mig1.bind_dna(target_promoters)",
      "    mig1.recruit_corepressor(ssn6_tup1)",
      "    ssn6_tup1.modify_chromatin(REPRESSIVE)",
      "    ",
      "    // Transcription blocked",
      "    gal_genes.expression = OFF",
      "    suc2.expression = OFF",
      "    mal_genes.expression = OFF",
      "    ",
      "    // WHILE loop - maintain state",
      "    WHILE (glucose > THRESHOLD):",
      "      MAINTAIN repression_state",
      "      MONITOR glucose_levels",
      "    ",
      "    // When glucose drops, reverse process",
      "    IF (glucose < THRESHOLD):",
      "      CALL derepress_genes()",
      "",
      "FUNCTION activate_glucose_metabolism():",
      "  glycolysis.flux = MAXIMUM",
      "  fermentation.active = TRUE",
      "  RETURN ethanol_production"
    ],
    
    "detailed_flow": [
      "// INPUT LAYER - Environmental Sensing",
      "glucose_concentration = environment.sense()",
      "",
      "// SENSOR LAYER",
      "snf3_signal = snf3.sense_glucose(glucose)  // High affinity sensor",
      "rgt2_signal = rgt2.sense_glucose(glucose)  // Low affinity sensor",
      "",
      "// LOGIC LAYER - AND Gate",
      "sensor_active = (glucose > 0.2) AND (rgt2_signal == HIGH)",
      "",
      "// REGULATION LAYER - State Machine",
      "IF (sensor_active):",
      "  // Snf1 inactivation pathway",
      "  reg1_phosphatase.activate()",
      "  snf1.phosphorylation_T210 = LOW",
      "  snf1.activity = INACTIVE  // State transition",
      "  ",
      "  // NOT gate - inverse relationship",
      "  mig1.phosphorylation = NOT(snf1.activity)",
      "  ",
      "  // Conditional transport",
      "  IF (mig1.phosphorylation == LOW):",
      "    // Nuclear import",
      "    import_signal = TRUE",
      "    msn5_exportin.activity = LOW",
      "    srp1_importin.bind(mig1)",
      "    mig1.localization = transport_to_nucleus(mig1)",
      "    ",
      "    // DNA binding cascade",
      "    IF (mig1.localization == NUCLEUS):",
      "      // Find target sites",
      "      target_sites = scan_genome(GC_RICH_MOTIF)",
      "      ",
      "      FOR site IN target_sites:",
      "        mig1.bind(site)",
      "        ",
      "        // Recruit corepressor",
      "        ssn6_tup1_complex = recruit_corepressor()",
      "        ",
      "        // Chromatin modification",
      "        hdac = ssn6_tup1_complex.recruit_hdac()",
      "        chromatin.deacetylate(site.region)",
      "        chromatin.state = REPRESSIVE",
      "        ",
      "        // Block transcription",
      "        rna_pol2.recruitment = BLOCKED",
      "        gene.transcription = OFF",
      "      ",
      "      // OUTPUT - Gene expression changes",
      "      GAL1.expression = 0.001 * basal  // 1000x repression",
      "      SUC2.expression = 0.01 * basal   // 100x repression",
      "      ",
      "      // Activate glucose pathway",
      "      glucose_metabolism.state = ACTIVE",
      "      ",
      "      // FEEDBACK LOOP - Monitor and maintain",
      "      WHILE (glucose > THRESHOLD):",
      "        current_state = check_repression()",
      "        IF (current_state != REPRESSED):",
      "          reinforce_repression()",
      "        glucose = sense_glucose()",
      "        SLEEP(check_interval)"
    ]
  },
  
