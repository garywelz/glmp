  "category": "Metabolic Regulation",
  "subcategory": "Carbon Source Regulation",
  "description": "Glucose repression is a regulatory mechanism where the presence of glucose represses genes required for the metabolism of alternative carbon sources. This is a classic example of biological programming with clear IF-THEN-ELSE logic.",
  
  "programming_framework": {
    "paradigm": "Event-driven regulatory program",
    "main_logic": "IF (glucose_high) THEN repress_alternative_pathways ELSE activate_alternative_pathways",
    "control_structures": [
      "IF-THEN-ELSE conditional",
      "AND gates (multiple input requirements)",
      "NOT gates (repression)",
      "WHILE loops (feedback maintenance)",
      "Signal transduction cascade"
    ],
    "complexity": {
      "cyclomatic_complexity": 8,
      "decision_points": 5,
      "feedback_loops": 2
    }
  },
  
  "key_components": {
    "sensors": ["Snf3", "Rgt2"],
    "transcription_factors": ["Mig1", "Mig2", "Rgt1"],
    "kinases": ["Snf1", "Reg1"],
    "repressed_genes": ["GAL1", "GAL2", "GAL7", "SUC2", "MAL"],
    "pathways": ["Glucose sensing", "Snf1 kinase cascade", "Mig1 regulation"]
  },
  
